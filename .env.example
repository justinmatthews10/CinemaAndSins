# Environment Variables — CinemaAndSins
# Copy this file to `.env.local` and fill in your values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# TMDB API (v3 API key from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your-tmdb-api-key

# Admin bootstrap — the first user to sign up with this email is
# auto-approved and granted admin privileges.
# Also set this in Supabase: ALTER DATABASE postgres SET app.admin_email = 'you@example.com';
ADMIN_EMAIL=your-admin-email@example.com
